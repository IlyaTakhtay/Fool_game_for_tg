
FROM python:3.12

WORKDIR /app

COPY ./config/requirements-dev.txt /app/requirements.txt

RUN pip install --no-cache-dir --upgrade -r /app/requirements.txt

COPY ./src /app/backend/src

ENV PYTHONPATH=/app

CMD ["uvicorn", "backend.src.api.main:app", "--reload", "--host", "0.0.0.0", "--port", "8000"]
